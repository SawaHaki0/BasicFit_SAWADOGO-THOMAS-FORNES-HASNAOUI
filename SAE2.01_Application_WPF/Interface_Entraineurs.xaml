<UserControl x:Class="SAE2._01_Application_WPF.Interface_Entraineurs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="450" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Gérer entraineurs" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,0,0" Grid.Column="1" Height="63" Width="351"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
        VerticalAlignment="Top" Margin="0,70,0,0" Grid.Column="1" Width="780" Height="70">
            
           
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" Height="200" Width="250" Margin="0,0,40,50">
            <Button Content="Créer entraîneur" Margin="0,12"/>
            <Button Content="Modifier entraîneur" Margin="0,12"/>
            <Button Content="Supprimer entraîneur" Margin="0,12"/>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Column="1" Height="270" Width="400" Margin="50,0,0,25">
            <DataGrid Height="270">

            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
