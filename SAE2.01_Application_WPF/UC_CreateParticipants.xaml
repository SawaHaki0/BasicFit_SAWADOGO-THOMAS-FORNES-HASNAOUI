<UserControl x:Class="SAE2._01_Application_WPF.FormulaireParticipant"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#F8FAFC" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button x:Name="btnRetour" Content="&lt;" FontSize="28" FontWeight="Bold" 
                    Foreground="#FF6B00" Background="Transparent" BorderBrush="Transparent" 
                    Cursor="Hand" Margin="0,0,20,0" VerticalAlignment="Center" Click="btnRetour_Click"/>

            <TextBlock Text="Créer participant" FontSize="32" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtNom" Text="Nom" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtPrenom" Text="Prenom" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtMail" Text="Mail" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtTelephone" Text="Téléphone" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtNaissance" Text="📅 Date de Naissance" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Margin="0,0,0,20" Height="45">
                    <TextBox x:Name="txtAdresse" Text="Adresse" Foreground="Gray" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="14" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
                </Border>

            </StackPanel>

            <Button x:Name="btnValiderParticipant" Grid.Column="1" Content="Valider Participant"
                    Background="#FF6B00" Foreground="White" FontSize="16" FontWeight="Bold"
                    Width="220" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,0,20" Click="btnValiderParticipant_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>