<UserControl x:Name="txtParticipants" x:Class="SAE2._01_Application_WPF.MainParticipants"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="White" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Rechercher Participants" FontSize="28" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="150" Height="30" Text="Recherche" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                <TextBox Width="150" Height="30" Text="Naissance" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                <TextBox Width="150" Height="30" Text="Adresse" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dgParticipants" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="PRENOM" Binding="{Binding Prenom}" Width="*"/>
                    <DataGridTextColumn Header="MAIL" Binding="{Binding Mail}" Width="1.5*"/>
                    <DataGridTextColumn Header="TELEPHONE" Binding="{Binding Telephone}" Width="*"/>
                    <DataGridTextColumn Header="DATE DE NAISSANCE" Binding="{Binding DateNaissance, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                    <DataGridTextColumn Header="ADRESSE" Binding="{Binding Adresse}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="btnCreerParticipant" Grid.Column="1" Content="Créer Participants"
                    Background="#FF6B00" Foreground="White" FontSize="16" FontWeight="Bold"
                    Width="200" Height="90" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Click="btnCreerParticipant_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="16"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

    </Grid>
</UserControl>