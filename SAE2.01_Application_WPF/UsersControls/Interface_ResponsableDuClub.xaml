<UserControl x:Class="SAE2._01_Application_WPF.Interface_ResponsableDuClub"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="25" BorderBrush="#FFD9A7" BorderThickness="0,0,0,1">
                <Border.Background>
                    <ImageBrush ImageSource="/img/Logo.png"/>
                </Border.Background>
            </Border>

            <Border Grid.Row="1" Background="#EBF3FF" BorderBrush="#FFD9A7" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Row="0">

   
                        <Button x:Name="menuPlanningJour" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" Margin="0,20,0,0" HorizontalContentAlignment="Left" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Planning du jour" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                   
                        <Button x:Name="menuSeances" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" HorizontalContentAlignment="Left" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BE;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Seances" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        
                        <Button x:Name="menuParticipants" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" HorizontalContentAlignment="Left" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Participants" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                      
                        <Button x:Name="menuCategories" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" HorizontalContentAlignment="Left" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF246;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Categories" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                       
                        <Button x:Name="menuGererEntraineurs" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" HorizontalContentAlignment="Left" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE13D;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Gérer entraineurs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                      
                        

                    </StackPanel>

            
                    <StackPanel Orientation="Vertical" Grid.Row="1">
                        <Button x:Name="menuLogout" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Width="Auto" Margin="0,0,0,10" HorizontalContentAlignment="Left" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="18" Margin="10,0,10,0"/>
                                <TextBlock Text="Logout" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        
        <Border Grid.Column="1" Grid.Row="0" Background="White" BorderBrush="#FFD9A7" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Système de gestion" VerticalAlignment="Center" FontSize="22" FontWeight="Bold"/>
                <Label Grid.Column="1" Content="Je suis Responsable Du club" VerticalAlignment="Center" Foreground="#FFDE8400" FontWeight="Bold" Margin="0,0,20,0"/>
                <Label Grid.Column="2" Content="Bienvenu" VerticalAlignment="Center" Foreground="#FFDE8400" FontWeight="Bold"/>
            </Grid>
        </Border>

    
        <Border Grid.Column="1" Grid.Row="1" Background="#F8FAFC" Padding="30">
            <Grid/>
        </Border>

    </Grid>
</UserControl>