<UserControl x:Class="SAE2._01_Application_WPF.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<Rectangle HorizontalAlignment="Left" Height="450" Stroke="#FFE68E0C" VerticalAlignment="Center" Width="400" Fill="#FFFE911B"/>
		<Rectangle HorizontalAlignment="Left" Height="450" Margin="400,0,0,0" Stroke="Black" VerticalAlignment="Center" Width="400" Fill="White"/>
		<Image Margin="-46,6,432,71" Source="/img/LogoVide.png" Stretch="Fill" RenderTransformOrigin="0.479,0.48">
			<Image.RenderTransform>
				<TransformGroup>
					<ScaleTransform/>
					<SkewTransform/>
					<RotateTransform Angle="-27.518"/>
					<TranslateTransform X="-2.464" Y="4.86"/>
				</TransformGroup>
			</Image.RenderTransform>
		</Image>
		<Image Margin="214,51,308,123" Source="/img/EmojiBiceps.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
			<Image.RenderTransform>
				<TransformGroup>
					<ScaleTransform ScaleX="-1"/>
					<SkewTransform/>
					<RotateTransform Angle="-24.668"/>
					<TranslateTransform/>
				</TransformGroup>
			</Image.RenderTransform>
		</Image>
		<Label Content="SE CONNECTER" HorizontalAlignment="Left" Margin="508,50,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>
		<TextBox x:Name="textboxUsername" HorizontalAlignment="Left" Margin="551,106,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" Width="141" FontSize="24"/>
		<PasswordBox x:Name="textBoxPassword" HorizontalAlignment="Left" Margin="551,145,0,0"  VerticalAlignment="Top" Width="141" FontSize="24"/>
		<Button x:Name="butConfirmer" Content="Confirmer" HorizontalAlignment="Left" Margin="508,318,0,0" VerticalAlignment="Top" Width="184" Height="35" FontSize="24" FontWeight="Bold" Background="#FFFE911B" Foreground="White">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="12"/>
				</Style>
			</Button.Resources>
		</Button>
		<Button x:Name="butQuiter" Content="Quitter" HorizontalAlignment="Left" Margin="508,369,0,0" VerticalAlignment="Top" Width="184" Height="35" FontSize="24" FontWeight="Bold" Background="#FFFE911B" Foreground="White">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="12"/>
				</Style>
			</Button.Resources>
		</Button>
		<Label Content="🔒" HorizontalAlignment="Left" Margin="508,140,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24" RenderTransformOrigin="0.576,1.694"/>
		<Label Content="👤" HorizontalAlignment="Left" Margin="508,102,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>



	</Grid>
</UserControl>
