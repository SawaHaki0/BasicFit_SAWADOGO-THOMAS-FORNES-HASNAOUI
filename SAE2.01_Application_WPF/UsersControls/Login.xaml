<UserControl x:Class="SAE2._01_Application_WPF.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>


		<Grid Grid.Column="0" Background="#FFFE911B">
			<Border BorderBrush="#FFE68E0C" BorderThickness="1"/>

			<Image Source="/img/LogoVide.png" Stretch="Uniform"
               Width="275" Height="264"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="41,36,0,0" RenderTransformOrigin="0.5,0.5">
				<Image.RenderTransform>
					<RotateTransform Angle="-27.518"/>
				</Image.RenderTransform>
			</Image>

			<Image Source="/img/EmojiBiceps.png" Stretch="Uniform"
               Width="294" Height="214"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,196,33,0" RenderTransformOrigin="0.5,0.5">
				<Image.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="-1"/>
						<RotateTransform Angle="-24.668"/>
					</TransformGroup>
				</Image.RenderTransform>
			</Image>
		</Grid>


		<Grid Grid.Column="1" Background="White">
			<Border BorderBrush="Black" BorderThickness="1"/>


			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="220">

				<Label Content="SE CONNECTER"
                   FontWeight="Bold" FontSize="24"
                   HorizontalAlignment="Center" Margin="0,0,0,24"/>


				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0" Content="👤" FontSize="24"
                       VerticalAlignment="Center"/>
					<TextBox Grid.Column="1" x:Name="textboxUsername"
                         Text="Username" FontSize="24"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
				</Grid>


				<Grid Margin="0,0,0,32">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0" Content="🔒" FontSize="24"
                       VerticalAlignment="Center"/>
					<PasswordBox Grid.Column="1" x:Name="textBoxPassword"
                             FontSize="24" VerticalAlignment="Center"/>
				</Grid>

				<Button x:Name="butConfirmer" Content="Confirmer"
                    Height="35" FontSize="24" FontWeight="Bold"
                    Background="#FFFE911B" Foreground="White"
                    Margin="0,0,0,12">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="12"/>
						</Style>
					</Button.Resources>
				</Button>

				<Button x:Name="butQuiter" Content="Quitter"
                    Height="35" FontSize="24" FontWeight="Bold"
                    Background="#FFFE911B" Foreground="White">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="12"/>
						</Style>
					</Button.Resources>
				</Button>

			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
