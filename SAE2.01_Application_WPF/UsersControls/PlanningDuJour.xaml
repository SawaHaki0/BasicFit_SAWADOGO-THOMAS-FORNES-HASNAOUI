<UserControl x:Class="SAE2._01_Application_WPF.PlanningDuJour"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		
		<TextBlock Grid.Row="0"
                   Text="Planning du jour"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#0E2235"/>

		
		<TextBlock Grid.Row="1"
                   x:Name="DateLabel"
                   Margin="0,4,0,20"
                   FontSize="12"
                   Foreground="#0E2235"/>

		
		<Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                ClipToBounds="True">
			<DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#7CC2E8"
                      VerticalGridLinesBrush="#7CC2E8"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      BorderThickness="0"
                      RowHeight="55"
                      ColumnHeaderHeight="38"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

				<DataGrid.ColumnHeaderStyle>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="Background" Value="#E5ECFB"/>
						<Setter Property="Foreground" Value="#0E2235"/>
						<Setter Property="FontSize" Value="12"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="Padding" Value="4"/>
					</Style>
				</DataGrid.ColumnHeaderStyle>

				<DataGrid.CellStyle>
					<Style TargetType="DataGridCell">
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="HorizontalAlignment" Value="Stretch"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
						<Setter Property="FontSize" Value="10"/>
						<Setter Property="Foreground" Value="#0E2235"/>
						<Setter Property="Padding" Value="4"/>
					</Style>
				</DataGrid.CellStyle>

				<DataGrid.Columns>
					<DataGridTextColumn Header="DESCRIPTION" Width="*"/>
					<DataGridTextColumn Header="SALLE" Width="*"/>
					<DataGridTextColumn Header="ENTREINEUR" Width="*"/>
					<DataGridTextColumn Header="PLACES" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		
		<Button Grid.Row="3"
                Content="Voir les participants"
                Background="#F26B1A"
                Foreground="White"
                FontWeight="SemiBold"
                FontSize="12"
                Padding="16,9"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"/>
	</Grid>
</UserControl>

