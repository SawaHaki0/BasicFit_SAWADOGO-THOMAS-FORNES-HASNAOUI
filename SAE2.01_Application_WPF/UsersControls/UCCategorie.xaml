<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UCCategorie"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="450" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Gérer catégorie" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,0,0,0" Grid.Column="1" Height="63" Width="301"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
    VerticalAlignment="Top" Margin="0,70,0,0" Grid.Column="1" Width="780" Height="75">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12" Height="30" Width="780">
                <Button Content="Toutes les catégories" Margin="6,0" Width="160" Background="#FFFF6B0F" Foreground="White" RenderTransformOrigin="0.5,0.5">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cardio &amp; Endurance" Margin="6,0" Width="150">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Renforcement musculaire" Margin="6,0" Width="150">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Bien-être &amp; Stretching" Margin="6,0" Width="150">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="HIIT" Margin="6,0" Width="90">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="776" Height="30">
                <Button Content="Danse &amp; Fitness rythmique" Margin="6,0" Width="170">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cycling" Margin="6,0" Width="60">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Pilates &amp; Core" Margin="6,0" Width="100">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Yoga &amp; Méditation" Margin="6,0" Width="130">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" Height="200" Width="190" Margin="0,0,40,50">
            <Button Content="Ajouter une catégorie" Margin="0,12" Height="40" Background="#FFFF6B0F" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Modifier une catégorie" Margin="0,12" Height="40" Background="#FFFF6B0F" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Supprimer une catégorie" Margin="0,12" Height="40" Background="#FFFF6B0F" BorderBrush="#FFEFDFDF" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Column="1" Height="270" Width="400" Margin="50,0,0,25">
            <DataGrid Height="270">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CATEGORIE" Width="125"/>
                    <DataGridTextColumn Header="DESCRIPTION" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
