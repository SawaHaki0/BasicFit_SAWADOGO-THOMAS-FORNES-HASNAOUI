<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UCCategorieAjouter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="450" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0" Grid.Column="1" Height="30" Width="40" Background="Transparent" >
            <TextBlock Text="&lt;"
               FontSize="40"
               Foreground="#FFFF6B0F"
               Margin="-5,-18,0,0"/>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
        </Button>
        <Label Content="Ajouter catégorie" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,0,0,0" Grid.Column="1" Height="63" Width="301"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
    VerticalAlignment="Top" Margin="0,80,0,0" Grid.Column="1" Width="600" Height="50" >
            <TextBox Height="40" Width="600" Margin="0,4,0,0" Text="Nom de la catégorie" FontSize="20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
VerticalAlignment="Top" Margin="0,155,0,0" Grid.Column="1" Width="600" Height="150">
            <TextBox Height="150" Width="600" Margin="0,4,0,0" Text="Description de la catégorie" FontSize="20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="0,350,0,0" Width="600" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="1">
            <Button Height="60" Background="#FFFF6B0F" Content="Modifier" Foreground="White" FontSize="20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
    
</UserControl>
