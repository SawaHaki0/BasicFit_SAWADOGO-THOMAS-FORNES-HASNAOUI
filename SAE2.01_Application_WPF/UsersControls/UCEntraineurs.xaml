        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0" x:Name="dgEntraineurs" ItemsSource="{Binding LesEntraineurs}"
                      AutoGenerateColumns="False" IsReadOnly="True" Background="White"
                      BorderBrush="#CBD5E1" RowHeight="35" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdEntraineur}" Width="60"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding NomEntraineur}" Width="*"/>
                    <DataGridTextColumn Header="Prénom" Binding="{Binding PrenomEntraineur}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,0,0">

                <Button x:Name="btnAjout" Content="Ajouter un entraîneur" Height="40" Margin="0,0,0,15"
                        Background="#FF6F00" Foreground="White" FontWeight="Bold" FontSize="14"
                        Cursor="Hand" Click="btnAjout_click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

