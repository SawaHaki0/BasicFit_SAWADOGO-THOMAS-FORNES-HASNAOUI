<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UCEntraineurs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="450" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Gérer entraineurs" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,0,0,0" Grid.Column="1" Height="63" Width="340"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
 VerticalAlignment="Top" Margin="0,70,0,0" Grid.Column="1" Width="780" Height="75">
            <TextBox Height="40" Text="Recherche" FontSize="26"/>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" Height="200" Width="190" Margin="0,0,40,50">
            <Button Content="Ajouter un entraineur" Margin="0,12" Height="40" Background="#FFFF6B0F" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Modifier un entraineur" Margin="0,12" Height="40" Background="#FFFF6B0F" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Supprimer un entraineur" Margin="0,12" Height="40" Background="#FFFF6B0F" BorderBrush="#FFEFDFDF" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Column="1" Height="270" Width="400" Margin="50,0,0,25">
            <DataGrid Height="270" ItemsSource="{Binding LesCategories}"
         AutoGenerateColumns="True" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM"
                     Binding="{Binding Categorie}"
                     Width="*" />

                    <DataGridTextColumn Header="PRENOM"
                     Binding="{Binding DescriptionCategorie}"
                     Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
