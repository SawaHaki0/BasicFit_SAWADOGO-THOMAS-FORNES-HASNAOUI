<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UC_ModifierEntraineur"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,30">
            <Button x:Name="btnRetour" Content="&lt;" Click="btnRetour_Click"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" 
                    Foreground="#C2410C" FontSize="28" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,10"/>
            <TextBlock Text="Modifier entraîneur" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Width="450">

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Background="White" Padding="15,10" Margin="0,0,0,20">
                <TextBox x:Name="txtSaisieNom" Foreground="Black" BorderThickness="0" Background="Transparent" FontSize="14"/>
            </Border>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="15" Background="White" Padding="15,10" Margin="0,0,0,20">
                <TextBox x:Name="txtSaisiePrenom" Foreground="Black" BorderThickness="0" Background="Transparent" FontSize="14"/>
            </Border>

        </StackPanel>

        <Button Grid.Row="2" x:Name="btnFinaliserModification" Content="Finaliser la modification" Click="btnFinaliserModification_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="200" Height="45"
                Foreground="White" FontWeight="Bold" FontSize="15" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
            <Button.Background>
                <SolidColorBrush Color="#FF6F00"/>
            </Button.Background>
        </Button>

    </Grid>
</UserControl>
