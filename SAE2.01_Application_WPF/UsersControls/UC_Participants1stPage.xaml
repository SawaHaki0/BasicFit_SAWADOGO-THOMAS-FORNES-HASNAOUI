<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UC_Participants1stPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White">

        <Grid>
            <TextBlock x:Name="tbTitrePage1" TextWrapping="Wrap" Margin="69,56,426,0" FontSize="25" FontWeight="Bold" VerticalAlignment="Top">
                <Run Language="fr-fr" Text="Rechercher Participants"/>
            </TextBlock>

            <TextBox x:Name="txtFiltreRecherche" HorizontalAlignment="Left" Margin="69,110,0,0" TextWrapping="Wrap" Text="Recherche" VerticalAlignment="Top" Width="120" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
            <TextBox x:Name="txtFiltreNaissance" HorizontalAlignment="Left" Margin="280,110,0,0" TextWrapping="Wrap" Text="Naissance" VerticalAlignment="Top" Width="120" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
            <TextBox x:Name="txtFiltreAdresse" HorizontalAlignment="Left" Margin="491,110,0,0" TextWrapping="Wrap" Text="Adresse" VerticalAlignment="Top" Width="120" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>
        </Grid>

        <Grid>
            <DataGrid x:Name="dgListeParticipants" Margin="69,155,235,44" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="PRENOM" Binding="{Binding Prenom}" Width="*"/>
                    <DataGridTextColumn Header="MAIL" Binding="{Binding Mail}" Width="1.5*"/>
                    <DataGridTextColumn Header="TELEPHONE" Binding="{Binding Telephone}" Width="*"/>
                    <DataGridTextColumn Header="DATE DE NAISSANCE" Binding="{Binding DateNaissance, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                    <DataGridTextColumn Header="ADRESSE" Binding="{Binding Adresse}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Button x:Name="btnOuvrirCreation" Content="Créer Participants"
                Background="#FF6B00" Foreground="White" FontSize="15" FontWeight="Bold"
                Width="200" Height="110" VerticalAlignment="Top" HorizontalAlignment="Right"
                Click="btnOuvrirCreation_Click" Margin="0,280,10,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="16"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</UserControl>