<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UC_Participants2ndPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <Grid Background="White">

        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="15,0,0,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="500"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Button x:Name="btnRetourPage1" Content="&lt;" HorizontalAlignment="Left" Margin="45,40,0,0" VerticalAlignment="Top" FontSize="30" FontWeight="Bold" Foreground="#FF6B00" Background="Transparent" BorderBrush="Transparent" Click="btnRetourPage1_Click"/>

        <TextBlock x:Name="tbTitrePage2" TextWrapping="Wrap" Margin="90,46,0,0" FontSize="25" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Run Language="fr-fr" Text="Créer participant"/>
        </TextBlock>

        <TextBox x:Name="txtSaisieNom" Margin="60,110,0,0" VerticalAlignment="Top" Text="Nom" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <TextBox x:Name="txtSaisiePrenom" Margin="60,170,0,0" VerticalAlignment="Top" Text="Prenom" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <TextBox x:Name="txtSaisieMail" Margin="60,230,0,0" VerticalAlignment="Top" Text="Mail" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <TextBox x:Name="txtSaisieTelephone" Margin="60,290,0,0" VerticalAlignment="Top" Text="Téléphone" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <TextBox x:Name="txtSaisieNaissance" Margin="60,350,0,0" VerticalAlignment="Top" Text="📅 Date de Naissance" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <TextBox x:Name="txtSaisieAdresse" Margin="60,410,0,0" VerticalAlignment="Top" Text="Adresse" Foreground="Gray" GotFocus="TextBox_Focus" LostFocus="TextBox_NoFocus"/>

        <Button x:Name="btnValiderCreation" Content="Valider Participant"
                Background="#FF6B00" Foreground="White" FontSize="15" FontWeight="Bold"
                Width="200" Height="45" VerticalAlignment="Top" HorizontalAlignment="Right"
                Click="btnValiderCreation_Click" Margin="0,408,30,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</UserControl>