<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UC_SeanceAjouter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button x:Name="btnRetour" Content="&lt;" 
            HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" 
            Foreground="#C2410C" FontSize="28" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,10" Click="btnRetour_Click"/>
            <TextBlock Text="Ajouter entraîneur" FontSize="32" FontWeight="Bold" Foreground="#0F172A" Margin="40,0,0,0"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="370" Margin="-45,79,0,0" Grid.RowSpan="2" Height="381">

            <TextBlock Text="Cours : " />
            <ComboBox x:Name="cbCours" DisplayMemberPath="NomCours" Width="250" Margin="0,5,0,10"/>
            <TextBlock Text="Entraîneur : " />
            <ComboBox x:Name="cbEntraineur" DisplayMemberPath="NomEntraineur" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Salle : " />
            <ComboBox x:Name="cbSalle" DisplayMemberPath="NomSalle" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Jour : " />
            <ComboBox x:Name="cbJour" DisplayMemberPath="Jour" Width="250" Margin="0,5,0,10">
                <ComboBoxItem Content="Lundi"/>
                <ComboBoxItem Content="Mardi"/>
                <ComboBoxItem Content="Mercredi"/>
                <ComboBoxItem Content="Jeudi"/>
                <ComboBoxItem Content="Vendredi"/>
                <ComboBoxItem Content="Samedi"/>
                <ComboBoxItem Content="Dimanche"/>
            </ComboBox>

            <TextBlock Text="Heure début (HH:mm) : " />
            <TextBox x:Name="txtHeureDebut" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Heure fin (HH:mm) : " />
            <TextBox x:Name="txtHeureFin" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Nombre de places : " />
            <TextBox x:Name="txtNbPlaces" Width="250" Margin="0,5,0,10"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="btnAjouter" Content="Ajouter séance"
        HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="200" Height="45"
        Foreground="White" FontWeight="Bold" FontSize="15" Cursor="" Click="btnAjouter_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
            <Button.Background>
                <SolidColorBrush Color="#FF6F00"/>
            </Button.Background>
        </Button>

    </Grid>
</UserControl>
