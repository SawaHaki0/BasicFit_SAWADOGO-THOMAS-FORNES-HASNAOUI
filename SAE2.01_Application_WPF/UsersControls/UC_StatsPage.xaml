<UserControl x:Class="SAE2._01_Application_WPF.UsersControls.UC_StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SAE2._01_Application_WPF.UsersControls"
             mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="800">

	<UserControl.Resources>
		<DataTemplate x:Key="BarreStat">
			<Grid Margin="0,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="160"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="110"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="{Binding Libelle}" VerticalAlignment="Center" Foreground="#334155" FontSize="13"/>
				<ProgressBar Grid.Column="1" Height="18" Minimum="0" Maximum="100" Value="{Binding Taux}"
                             Foreground="#FF6B00" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="13" Foreground="#0F172A"/>
			</Grid>
		</DataTemplate>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
		<StackPanel Margin="40,30">

			<TextBlock Text="Statistiques de fréquentation" FontSize="28" FontWeight="Bold"
                       Foreground="#0F172A" Margin="0,0,0,20"/>

			<!-- ===== INDICATEURS CLÉS ===== -->
			<UniformGrid Rows="1" Columns="4" Margin="0,0,0,30">
				<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Taux de remplissage" FontSize="12" Foreground="#64748B"/>
						<TextBlock x:Name="txtTauxGlobal" Text="-" FontSize="28" FontWeight="Bold" Foreground="#FF6B00" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>
				<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Séances" FontSize="12" Foreground="#64748B"/>
						<TextBlock x:Name="txtNbSeances" Text="-" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>
				<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Inscriptions" FontSize="12" Foreground="#64748B"/>
						<TextBlock x:Name="txtNbInscriptions" Text="-" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>
				<Border Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Catégorie la + suivie" FontSize="12" Foreground="#64748B"/>
						<TextBlock x:Name="txtTopCategorie" Text="-" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,0" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>
			</UniformGrid>

			<!-- ===== PAR JOUR ===== -->
			<Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,25" BorderBrush="#E2E8F0" BorderThickness="1">
				<StackPanel>
					<TextBlock Text="Taux de remplissage par jour" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
					<ItemsControl x:Name="icParJour" ItemTemplate="{StaticResource BarreStat}"/>
				</StackPanel>
			</Border>

			
			<Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
				<StackPanel>
					<TextBlock Text="Taux de remplissage par catégorie" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
					<ItemsControl x:Name="icParCategorie" ItemTemplate="{StaticResource BarreStat}"/>
				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>